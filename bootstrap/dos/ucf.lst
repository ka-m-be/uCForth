0AE5  01
0AE6  09 DB 74 19           BEGIN,  BX BX OR,  NZ WHILE,
0AEA  8B 3F                   DI 0 [BX] MOV,
0AEC  09 FF 74 0E             BEGIN,  DI DI OR,  NZ WHILE,
0AF0  39 C7 76 06 39 D7         DI AX CMP,  A IF,  DI DX CMP,  B IF,  DX DI MOV,  THEN,  THEN,
0AF6  73 02 89 FA
0AFA  8B 3D                     DI 0 [DI] MOV,
0AFC  EB EE                   REPEAT,
0AFE  8B 5F 02                BX 2 [BX] MOV,
0B01  EB E3                 REPEAT,
0B03  89 D0 C3              AX DX MOV,  RET,
