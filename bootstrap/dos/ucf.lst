070D  3F D1 E7 2E FF A5
0713  03 01
0715  83 C5 06 AD 93 8B   65 CODE UNLOOP    BP 6 ADDI,  NEXT,
071B  3F D1 E7 2E FF A5
0721  03 01
                          
                          \ ==== Primitive 66: machine code in the dictionary =======================
                          \ A CODE word (lib/pc/asm.fs) has the code field 66, and its machine
                          \ code follows, in the segment of the VM. DOCODE puts the way back on
                          \ the return stack, the far address of CODE-NEXT (the offset in the
                          \ lower cell, the segment of the kernel in the upper one), and jumps to
                          \ the code with RETF: CS is then the segment of the VM. The code ends
                          \ with NEXT, of the package ASM: it takes the way back from the return
                          \ stack and jumps to CODE-NEXT, the NEXT of the kernel.
                          
0723  AD 93 8B 3F D1 E7   LABEL CODE-NEXT   NEXT,
0729  2E FF A5 03 01
                          66 CODE DOCODE
072E  83 ED 04 C7 46 00     BP 4 SUBI,  0 [BP] CODE-NEXT MOVI,  2 [BP] CS MOV,    \ the way back
0734  23 07 8C 4E 02
0739  1E 8D 47 02 50 CB     DS PUSH,  AX 2 [BX] LEA,  AX PUSH,  RETF,             \ to the code after the code field

\ ==== targets/dos/hal.fs
                          \ hal.fs - the HAL of uCForth for MS-DOS: start, console, files, images
                          \
                          \ UCF.COM runs on each PC with MS-DOS 2.0 or newer, FreeDOS, DR-DOS,
                          \ and in the DOS box of 32-bit Windows. It needs 128 KB of free memory:
                          \ its own segment of 64 KB (the code, buffers) and a second segment of
                          \ 64 KB, the memory of the VM. Loaded by build.fs after kernels/8086.fs.
                          \
                          \ UCF.COM is a bootstrap VM without Genesis and a target at once:
                          \ - with an image in the file (build.fs puts it after the code), it
                          \   starts this image;
                          \ - without it, it loads an image file: UCF -image SEED.HEX BASE.FS ...
                          \ The files of the command line load first, line by line through ?RX,
                          \ then the keyboard or a file with "<" (doc/vm.md, section 9). With the
                          \ seed (its start word is QUIT), the first file must be forth/base.fs:
                          \ after it the kernel completes the base (doc/genesis.md, section 6),
                          \ and "-dump FILE" writes the base image. FREEZE writes UCF.HEX.
                          \
                          \ The calls of DOS: INT 21h with the function in AH: 3Ch create a file,
                          \ 3Dh open, 3Eh close, 3Fh read, 40h write, 42h move the file pointer,
                          \ 44h IOCTL (is a handle a device?), 0Bh is a key there, 25h and 35h
                          \ set and get an interrupt vector, 4Ch end the program. The clock is
                          \ the tick counter of the BIOS at 0040:006C (18.2 ticks per second).
                          \
                          \ Registers: as in kernels/8086.fs. The subroutines here (CALL, RET)
                          \ keep SI BP DS ES, unless the comment says other. Variables of the
                          \ HAL are in the code segment: "CS: AX IN-POS [] MOV," reads one.
                          
                          \ ==== Memory of the code segment ========================================
                          \ DOS gives a .COM program its segment of 64 KB. The code starts at
                          \ $100 (before it: the PSP of DOS, with the command line at $80). The
                          \ image follows the code (IMAGE-AT); buffers lie at the end.
                          
                          $F000 CONSTANT LINE-BUF      \ the input line for ?RX: the text and LF
                          $F200 CONSTANT OUT-BUF       \ the output line of TX!, 256 bytes
                          $F300 CONSTANT NAME-BUF      \ a file name with a byte 0 at its end
                          $F400 CONSTANT REC-BUF       \ a line of an image file while it is written
                          $F480 CONSTANT NUM-BUF       \ the digits of a number
                          $F490 CONSTANT ARG-LIST      \ the files of the command line: 16 addresses
                          $F4B0 CONSTANT FID-TAB       \ fid 10 to 29: the handle of DOS + 1, or 0 (free)
                          20 CONSTANT #FIDS
                          $F500 CONSTANT OPTAB0        \ a copy of the table of the primitives, for BREAK
                          16 CONSTANT #ARGS
                          $FFF0 CONSTANT REGS          \ SYSCALL: AX BX CX DX SI DI flags ES, in the VM
                          DP CONSTANT SYS-START        \ the system variables start with DP at $0100
                          WL-FORTH CONSTANT DATA-START \ the RAM data start with the wordlist FORTH at $0200
                          
                          : DOS, ( ah -- )   AH SWAP MOVI,  $21 INT, ;     \ a call of DOS
                          : C$, ( a u -- )   DUP TC, TS, ;                 \ a counted text in the code
                          
                          \ ==== Variables =========================================================
                          
073F  00 00               LABEL VMSEG        0 T,         \ the segment of the VM
0741  00 00 00 00         LABEL OLD1B        0 T, 0 T,    \ the vector of INT 1Bh before the start: offset, segment
0745  00 00               LABEL START-TICKS  0 T,         \ the clock at the start
0747  00 00               LABEL TTY          0 T,         \ not 0: the input is a device (the keyboard)
0749  00 00               LABEL WAITING      0 T,         \ not 0: DOS reads a line of the keyboard now
074B  00 00               LABEL BRK-FLAG     0 T,         \ not 0: Ctrl-Break came; BREAK runs next
074D  00 00               LABEL IN-POS       0 T,         \ the next character of LINE-BUF for ?RX
074F  00 00               LABEL IN-LEN       0 T,         \ the characters in LINE-BUF, with the LF
0751  00 00               LABEL OUT-LEN      0 T,         \ the characters in OUT-BUF
0753  00 00               LABEL ERRSEEN      0 T,         \ not 0: an output line had "error:"
0755  00 00               LABEL NARGS        0 T,         \ the files of the command line
0757  00 00               LABEL ARGI         0 T,         \ the next of them to load
0759  00 00               LABEL CUR-FID      0 T,         \ the file that loads now, or 0
075B  00 00               LABEL CUR-NAME     0 T,         \ its name
075D  00 00               LABEL CUR-LN       0 T,         \ its line number
075F  00 00               LABEL SEEDED       0 T,         \ not 0: the image is a seed, the first file is base.fs
0761  00 00               LABEL IMG-NAME     0 T,         \ -image FILE, or 0
0763  00 00               LABEL DUMP-NAME    0 T,         \ -dump FILE, or 0
0765  00 00               LABEL IMG-FID      0 T,         \ the image file that is read or written
0767  00 00               LABEL IMG-BOOT     0 T,         \ WRITE-IMAGE: the start word
0769  00 00               LABEL XT-REFILL    0 T,         \ the body of REFILL: QUIT waits for a line there
076B  00 00               LABEL REFILL-END   0 T,
076D  00 00               LABEL OUT-A        0 T,         \ the address of OUT, the column of the output
076F  00 00               LABEL FAM          0 T,         \ OPEN-FILE: the access
0771  00 00               LABEL RL-BUF       0 T,         \ RDLINE: the buffer, its size, the bytes read
0773  00 00               LABEL RL-MAX       0 T,
0775  00 00               LABEL RL-GOT       0 T,
0777  00 00               LABEL RL-PEEK      0 T,         \ RDLINE: the two bytes after a full buffer
0779  00 00               LABEL RL-LF        0 T,         \ RDLINE: not 0 if the line ended with LF
077B  00 00               LABEL CUR-LF       0 T,         \ the file so far ended with LF: one more line comes
077D  00 00               LABEL SC-AX        0 T,         \ SYSCALL: AX, the flags and ES after the call
077F  00 00               LABEL SC-FL        0 T,
0781  00 00               LABEL SC-ES        0 T,
0783  00 00               LABEL IMAGE-LEN    0 T,         \ build.fs: the bytes of the image after the code; 0: none
0785  00 00 00 00 00 00   LABEL PRIMS$       32 TDP +!    \ the primitives of the image, as text (counted)
078B  00 00 00 00 00 00
0791  00 00 00 00 00 00
0797  00 00 00 00 00 00
079D  00 00 00 00 00 00
07A3  00 00
                          
